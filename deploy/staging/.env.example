# EXAMPLE ONLY — no real credentials. Never commit filled-in copies.
# Separate staging database and Redis; never point staging to production.
DATABASE_URL=
REDIS_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default OFF until a protected staging sandbox is explicitly reviewed.
ENABLE_SANDBOX_DISPATCH=false
SANDBOX_EVENT_TRANSPORT=postgres

# Machine-only health probe. 32+ unpredictable characters, independent of Better Auth.
SANDBOX_MONITOR_TOKEN=

# Configure HTTPS endpoints only, except loopback during local testing.
SANDBOX_MONITOR_URL=
SANDBOX_ALERT_WEBHOOK_URL=
