{
  "name": "superapp-mobility-food",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@superapp/web",
    "build": "npm run db:generate && turbo build --filter=@superapp/web",
    "build:web": "npm run build",
    "db:generate": "npm run generate -w @superapp/database",
    "db:migrate": "npm run migrate -w @superapp/database",
    "db:deploy": "npm run deploy -w @superapp/database",
    "db:studio": "npm run studio -w @superapp/database",
    "lint": "turbo lint",
    "typecheck": "npm run db:generate && turbo typecheck",
    "test": "turbo test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "sandbox:bridge": "node scripts/sandbox-redis-bridge.mjs",
    "sandbox:benchmark": "node scripts/outbox-benchmark-smoke.mjs",
    "sandbox:circuit-test": "node scripts/broker-circuit-smoke.mjs",
    "test:visual": "node scripts/visual-browser-smoke.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "pg": "^8.16.0",
    "redis": "^5.0.0",
    "playwright": "^1.56.1"
  }
}
